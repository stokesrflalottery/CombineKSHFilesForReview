# ==============================================================================
# Florida Lottery Database Extraction Credentials
# Save this file as 'db_credentials.properties' in your working directory
# or at: C:\ocioldapps1\Cached\DbCache\db_credentials.properties
# (Make sure this file is kept private and excluded from git)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OLTP Database Credentials (oci_devoltp)
# Host: ocioldodb1:15210 | Service: DEVCDB_DEVOLTP.paas.oracle.com
# ------------------------------------------------------------------------------
devoltp.user=YOUR_OLTP_USERNAME
devoltp.password=YOUR_OLTP_PASSWORD

# ------------------------------------------------------------------------------
# 2. Data Warehouse Credentials (oci_devdw)
# Host: ocioldodb1:15210 | Service: DEVCDB_DEVDW.paas.oracle.com
# ------------------------------------------------------------------------------
devdw.user=YOUR_DW_USERNAME
devdw.password=YOUR_DW_PASSWORD
